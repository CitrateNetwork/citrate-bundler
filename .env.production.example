# =============================================================================
# citrate-bundler — PRODUCTION environment template.
#
# Copy to `.env` next to docker-compose.yml and fill EVERY required value before
# `docker compose up -d --build`. NEVER commit the filled-in .env.
# =============================================================================

# ---- Public host ------------------------------------------------------------
# Caddy obtains TLS for this hostname via Let's Encrypt. DNS must already
# point at this droplet (gray-cloud at Cloudflare per the existing
# infer/auth/rpc pattern).
BUNDLER_HOST=bundler.citrate.ai

# ---- Chain network ----------------------------------------------------------
# JSON-RPC endpoint the bundler submits batches to. Internal chain 40204 RPC.
BUNDLER_NETWORK_RPC=https://rpc.citrate.ai

# EntryPoint v0.7 address on chain 40204. Populated AFTER deploying
# eth-infinitism/account-abstraction's EntryPoint to the chain (one-time
# deploy via the upstream's own script). Cross-check via eth_getCode.
BUNDLER_ENTRYPOINT=

# ---- Bundler operator wallet -----------------------------------------------
# BIP-39 mnemonic of the operator EOA the bundler uses to submit batches
# to the EntryPoint on chain. MUST hold native SALT to pay gas for batched
# UserOps; refill from the treasury when low. Funds spent here are
# reimbursed by users' paymaster/UserOp.
#
# Generate offline (do NOT use a brain wallet):
#   `openssl rand -hex 32`  → seed into a BIP-39 generator
BUNDLER_MNEMONIC=

# ---- Redis (auth sidecar rate-limit + paymaster-precheck cache) ----------
# Used by the Citrate auth sidecar landing in WP-4 slice B. The bundler
# proper doesn't need Redis; declared here so the compose service is up
# when the sidecar lands.
#   `openssl rand -hex 32`
REDIS_PASSWORD=
