# Caddy reverse proxy for the Citrate ERC-4337 bundler.
#
# Public TLS is automatic via Let's Encrypt against {$BUNDLER_HOST}
# (set in .env, typically "bundler.citrate.ai").
#
# Routes:
#   /health    — Caddy-handled trivial liveness ("ok"); no upstream call.
#   /healthz   — composite health from the gate (upstream bundler + Redis).
#   /          — JSON-RPC proxied through the Citrate GATE (WP-4 slice B:
#                bk_ API keys, per-IP + per-key rate limits, paymaster
#                pre-check, structured logs) which forwards to the
#                eth-infinitism bundler on bundler:3000.
#
# /metrics is intentionally NOT routed publicly — scrape it from the
# droplet: docker compose exec gate wget -qO- http://localhost:3001/metrics

{
    email saulweiloveman@gmail.com
}

{$BUNDLER_HOST} {
    encode zstd gzip

    @health path /health
    respond @health "ok" 200

    @metrics path /metrics
    respond @metrics "metrics are not public" 403

    # Per-IP (60/min anonymous) + per-API-key (600/min) rate limits,
    # bk_ key auth, and the paymaster pre-check live in the gate
    # (Redis-backed) — see gate/src/server.ts.
    reverse_proxy gate:3001 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote_host}

        transport http {
            read_timeout 60s
            write_timeout 60s
            dial_timeout 5s
            keepalive 30s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
    }
}
